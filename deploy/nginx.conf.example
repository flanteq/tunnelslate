# Host nginx forwards to the panel port published by docker-compose.yml.
# Set TUNNELSLATE_TRUSTED_PROXIES to the nginx source IP seen by the app
# to record client IPs in administrator sessions. Forwarded headers below are already set.
# Host nginx example. Replace hostname and certificate paths before enabling.
# .env must use PUBLIC_URL=https://tunnelslate.example.com and COOKIE_SECURE=true.
server {
    listen 80;
    server_name tunnelslate.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tunnelslate.example.com;

    ssl_certificate /etc/letsencrypt/live/tunnelslate.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tunnelslate.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # SSE: preserve the full URI, including the panel base path.
    location = /api/events {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Private profiles and link sessions must not enter a proxy cache.
        proxy_cache off;
        proxy_connect_timeout 5s;
        # Allow provider tests to wait for RADIUS MFA confirmation.
        proxy_read_timeout 360s;
    }
}
