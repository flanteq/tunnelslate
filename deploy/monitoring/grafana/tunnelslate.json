    {
      "id": 12,
      "title": "Current profile certificates \u00b7 days remaining (revoked excluded)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(tunnelslate_profile_certificate_not_after_timestamp_seconds{job=\"$job\",instance=~\"$instance\"} - time()) / 86400",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days remaining",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "client_id": true,
              "device_id": true
            },
            "renameByName": {
              "Value": "Days remaining",
              "instance": "Server",
              "client": "Client",
              "device": "Device",
              "serial": "Serial"
            }
          }
        }
      ]
    },
