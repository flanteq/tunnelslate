      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (client, instance) (increase(tunnelslate_client_traffic_bytes_total{job=\"$job\",instance=~\"$instance\"}[$__range])))",
          "legendFormat": "{{client}} \u00b7 {{instance}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
