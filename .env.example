# The first administrator is named admin. No credentials need to be configured.
# A random initial password is saved to /data/app/initial_admin_password.
# Sign in with it, then choose a permanent password in the panel.

# Default: HTTPS reverse proxy. Replace this hostname with your real hostname.
# For direct local HTTP: http://localhost:8090 and COOKIE_SECURE=false.
TUNNELSLATE_PUBLIC_URL=https://tunnelslate.example.com
# Optional URL prefix, for example /ovpn. Empty serves the panel at /.
TUNNELSLATE_BASE_PATH=
TUNNELSLATE_COOKIE_SECURE=true
TUNNELSLATE_SESSION_TTL=12h
# Audit log retention in days (1-36500). Cleanup runs at startup and hourly.
TUNNELSLATE_AUDIT_RETENTION_DAYS=365
# VPN statistics retention in days (1-36500). Cleanup at startup and daily.
# Lifetime device, client and server totals are kept.
TUNNELSLATE_STATS_RETENTION_DAYS=90

# Optional: comma-separated IP addresses/CIDRs of your reverse proxies.
# Used for session addresses and sign-in IP limits.
# Empty: ignore forwarded headers; users behind one proxy share its limit.
TUNNELSLATE_TRUSTED_PROXIES=
